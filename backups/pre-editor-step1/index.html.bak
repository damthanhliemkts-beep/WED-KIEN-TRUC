<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Living Blueprint — Portfolio cá nhân kiến trúc sư thực hành kiến trúc &amp; nội thất đương đại. Trải nghiệm biến đổi không gian kiến trúc 4 giai đoạn.">
  <meta name="robots" content="noindex, nofollow">
  <title>Living Blueprint — Kiến trúc &amp; Nội thất</title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Living Blueprint — Kiến trúc &amp; Nội thất">
  <meta property="og:description" content="Portfolio cá nhân kiến trúc sư thực hành kiến trúc &amp; nội thất tối giản đương đại.">
  <meta property="og:locale" content="vi_VN">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23F5F3EF'/%3E%3Cline x1='8' y1='8' x2='8' y2='22' stroke='%231A1916' stroke-width='2'/%3E%3Cline x1='8' y1='22' x2='15' y2='22' stroke='%231A1916' stroke-width='2'/%3E%3Cline x1='18' y1='8' x2='18' y2='22' stroke='%231A1916' stroke-width='2'/%3E%3Cpath d='M18 8 L25 8 Q28 8 28 12 Q28 15 18 16' stroke='%231A1916' stroke-width='1.5' fill='none'/%3E%3Cpath d='M18 16 L26 16 Q30 16 30 20 Q30 24 18 24' stroke='%231A1916' stroke-width='1.5' fill='none'/%3E%3Cline x1='8' y1='28' x2='28' y2='28' stroke='%23A8865C' stroke-width='1'/%3E%3C/svg%3E">

  <!-- Google Fonts: Cormorant Garamond, Inter, Space Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Foundation CSS -->
  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/typography.css">
  <link rel="stylesheet" href="css/layout.css">

  <!-- Global Components CSS — Phase 1 -->
  <link rel="stylesheet" href="css/components/navbar.css">
  <link rel="stylesheet" href="css/components/drawer.css">
  <link rel="stylesheet" href="css/components/cursor.css">
  <link rel="stylesheet" href="css/components/footer.css">
  <link rel="stylesheet" href="css/components/loader.css">

  <!-- Phase 2: Hero & Home Styles -->
  <link rel="stylesheet" href="css/components/hero.css">
  <link rel="stylesheet" href="css/pages/home.css">

  <!-- GSAP & ScrollTrigger (Local vendor scripts with fallback) -->
  <script src="js/vendor/gsap.min.js"></script>
  <script src="js/vendor/ScrollTrigger.min.js"></script>
</head>

<body>

  <!-- ── 1. PAGE LOADER ── -->
  <div class="page-loader" aria-hidden="false">
    <div class="page-loader__content">
      <img src="assets/svg/logo.svg" alt="" class="page-loader__logo" width="48" height="48">
      <span class="page-loader__brand">Living Blueprint</span>
      <div class="page-loader__line-wrap" aria-hidden="true">
        <div class="page-loader__line"></div>
      </div>
    </div>
  </div>

  <!-- ── 2. CUSTOM RING CURSOR (Desktop only) ── -->
  <div class="custom-cursor is-hidden" aria-hidden="true">
    <div class="custom-cursor__dot"></div>
    <div class="custom-cursor__ring">
      <span class="custom-cursor__label">XEM</span>
    </div>
  </div>

  <!-- ── 3. MOBILE FULLSCREEN DRAWER ── -->
  <aside id="mobile-nav-drawer" class="mobile-drawer" aria-label="Menu di động" aria-hidden="true">
    <div class="mobile-drawer__header">
      <a href="index.html" class="mobile-drawer__brand">
        <img src="assets/svg/logo.svg" alt="" width="28" height="28">
        <span class="mobile-drawer__brand-title">Living Blueprint</span>
      </a>
      <button class="mobile-drawer__close" type="button" aria-label="Đóng menu">
        <img src="assets/svg/icons/close.svg" alt="" class="mobile-drawer__close-icon" width="18" height="18">
      </button>
    </div>

    <nav class="mobile-drawer__nav" aria-label="Liên kết điều hướng di động">
      <ul class="mobile-drawer__list" role="list">
        <li class="mobile-drawer__item">
          <a href="projects.html" class="mobile-drawer__link">
            <span class="mobile-drawer__num">01</span>
            <span class="mobile-drawer__text">Dự án</span>
          </a>
        </li>
        <li class="mobile-drawer__item">
          <a href="about.html" class="mobile-drawer__link">
            <span class="mobile-drawer__num">02</span>
            <span class="mobile-drawer__text">Giới thiệu</span>
          </a>
        </li>
        <li class="mobile-drawer__item">
          <a href="about.html#process" class="mobile-drawer__link">
            <span class="mobile-drawer__num">03</span>
            <span class="mobile-drawer__text">Quy trình</span>
          </a>
        </li>
        <li class="mobile-drawer__item">
          <a href="contact.html" class="mobile-drawer__link">
            <span class="mobile-drawer__num">04</span>
            <span class="mobile-drawer__text">Liên hệ</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mobile-drawer__footer">
      <span class="mobile-drawer__meta">Liên hệ hợp tác</span>
      <a href="mailto:hello@livingblueprint.demo" class="mobile-drawer__email">hello@livingblueprint.demo</a>
      <span class="mobile-drawer__note">Mọi ý tưởng kiến trúc hiển thị là tác phẩm minh họa mẫu.</span>
    </div>
  </aside>

  <!-- ── PAGE WRAPPER ── -->
  <div class="page-wrapper">

    <a href="#main-content" class="sr-only">Bỏ qua điều hướng đến nội dung chính</a>

    <!-- ── 4. HEADER & NAVBAR ── -->
    <header role="banner">
      <nav class="site-navbar" aria-label="Điều hướng chính">
        <div class="site-navbar__inner">
          <a href="index.html" class="site-navbar__brand" aria-label="Living Blueprint — Trang chủ">
            <img src="assets/svg/logo.svg" alt="" class="site-navbar__logo-icon" width="32" height="32">
            <div class="site-navbar__brand-text">
              <span class="site-navbar__brand-title">Living Blueprint</span>
              <span class="site-navbar__brand-sub">Kiến trúc &amp; Nội thất</span>
            </div>
          </a>

          <div class="site-navbar__nav">
            <ul class="site-navbar__links" role="list">
              <li><a href="projects.html" class="site-navbar__link">Dự án</a></li>
              <li><a href="about.html" class="site-navbar__link">Giới thiệu</a></li>
              <li><a href="about.html#process" class="site-navbar__link">Quy trình</a></li>
              <li><a href="contact.html" class="site-navbar__link">Liên hệ</a></li>
            </ul>

            <a href="contact.html" class="site-navbar__cta" aria-label="Gửi yêu cầu tư vấn">
              <span>Tư vấn</span>
              <span class="site-navbar__cta-plus" aria-hidden="true">+</span>
            </a>
          </div>

          <!-- Mobile Toggle Button -->
          <button class="site-navbar__toggle" type="button" aria-label="Mở menu điều hướng di động" aria-expanded="false" aria-controls="mobile-nav-drawer">
            <span class="site-navbar__toggle-line"></span>
            <span class="site-navbar__toggle-line"></span>
          </button>
        </div>
      </nav>
    </header>

    <!-- ── MAIN CONTENT ── -->
    <main id="main-content">

      <!-- ========================================================
           PHASE 2: CINEMATIC HERO SCROLL (4-STAGE TRANSFORMATION)
           Stage 1: Sketch → Stage 2: Blueprint → Stage 3: 3D → Stage 4: Reality
           ======================================================== -->
      <section class="hero-cinematic" aria-label="Trải nghiệm kiến trúc tương tác 4 giai đoạn">
        <div class="hero-cinematic__sticky">

          <!-- Background Atmospheric Tone Transitions -->
          <div class="hero-cinematic__bg-blueprint" aria-hidden="true"></div>
          <div class="hero-cinematic__bg-reality" aria-hidden="true"></div>

          <!-- Top HUD Bar: Stage Metadata & Stepper Buttons -->
          <div class="hero-cinematic__hud" aria-live="polite">
            <div class="hero-hud__stage-info">
              <span class="hero-hud__index">01 / 04</span>
              <h2 class="hero-hud__label">PHÁC THẢO BAN ĐẦU</h2>
              <p class="hero-hud__desc">Nét vẽ không gian tự do, xác lập hệ trục chính và cân chỉnh điểm tụ phối cảnh.</p>
            </div>

            <!-- Stage jump stepper -->
            <nav class="hero-hud__stepper" aria-label="Chuyển nhanh giai đoạn kiến trúc">
              <button class="hero-hud__step-btn is-active" data-stage="0" type="button" aria-label="Giai đoạn 1: Phác thảo">
                <span class="hero-hud__step-name">01 Phác thảo</span>
                <span class="hero-hud__step-pill"></span>
              </button>
              <button class="hero-hud__step-btn" data-stage="1" type="button" aria-label="Giai đoạn 2: Bản vẽ kỹ thuật">
                <span class="hero-hud__step-name">02 Kỹ thuật</span>
                <span class="hero-hud__step-pill"></span>
              </button>
              <button class="hero-hud__step-btn" data-stage="2" type="button" aria-label="Giai đoạn 3: Phối cảnh 3D">
                <span class="hero-hud__step-name">03 Khối 3D</span>
                <span class="hero-hud__step-pill"></span>
              </button>
              <button class="hero-hud__step-btn" data-stage="3" type="button" aria-label="Giai đoạn 4: Hoàn thiện thực tế">
                <span class="hero-hud__step-name">04 Hoàn thiện</span>
                <span class="hero-hud__step-pill"></span>
              </button>
            </nav>
          </div>

          <!-- Visual Stage: Master Architectural SVG (Unified Perspective Model) -->
          <div class="hero-cinematic__stage">
            <svg class="hero-architectural-svg" viewBox="0 0 1600 1000" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mô hình công trình biệt thự pavilion hiện đại qua 4 giai đoạn kiến trúc">
              <title>Living Blueprint — Architectural Transformation</title>

              <!-- Shared Definitions: Grids, Patterns & Gradients -->
              <defs>
                <!-- Blueprint Fine Grid (10x10) -->
                <pattern id="blueprint-grid-fine" width="10" height="10" patternUnits="userSpaceOnUse">
                  <path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(74, 144, 217, 0.08)" stroke-width="0.7"/>
                </pattern>
                <!-- Blueprint Major Grid (50x50) -->
                <pattern id="blueprint-grid-major" width="50" height="50" patternUnits="userSpaceOnUse">
                  <rect width="50" height="50" fill="url(#blueprint-grid-fine)"/>
                  <path d="M 50 0 L 0 0 0 50" fill="none" stroke="rgba(74, 144, 217, 0.22)" stroke-width="1"/>
                </pattern>

                <!-- Wood Teak Louvers Pattern for Reality -->
                <pattern id="teak-louvers" width="8" height="20" patternUnits="userSpaceOnUse">
                  <rect width="4" height="20" fill="#9C7244"/>
                  <rect x="4" width="4" height="20" fill="#BD9360"/>
                  <line x1="0" y1="0" x2="0" y2="20" stroke="#7A5630" stroke-width="0.8"/>
                </pattern>

                <!-- Travertine Stone Courses Pattern -->
                <pattern id="travertine-bands" width="60" height="18" patternUnits="userSpaceOnUse">
                  <rect width="60" height="18" fill="#E6DFD3"/>
                  <line x1="0" y1="18" x2="60" y2="18" stroke="#CEC5B6" stroke-width="1"/>
                  <line x1="30" y1="0" x2="30" y2="18" stroke="#CEC5B6" stroke-width="0.6"/>
                </pattern>

                <!-- Glass Reflections Gradient -->
                <linearGradient id="glass-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#CBE0E8" stop-opacity="0.45"/>
                  <stop offset="40%" stop-color="#EAF5F8" stop-opacity="0.75"/>
                  <stop offset="60%" stop-color="#A8C7D2" stop-opacity="0.30"/>
                  <stop offset="100%" stop-color="#8BB0BC" stop-opacity="0.60"/>
                </linearGradient>

                <!-- Pool Water Shimmer Gradient -->
                <linearGradient id="pool-shimmer" x1="0" y1="0" x2="1" y2="0.6">
                  <stop offset="0%" stop-color="#5B8D99"/>
                  <stop offset="50%" stop-color="#7BB4C2"/>
                  <stop offset="100%" stop-color="#4A7985"/>
                </linearGradient>

                <!-- Warm Interior Light Radial Glow -->
                <radialGradient id="interior-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#FFE8B8" stop-opacity="0.9"/>
                  <stop offset="40%" stop-color="#E8C482" stop-opacity="0.6"/>
                  <stop offset="100%" stop-color="#C49B52" stop-opacity="0"/>
                </radialGradient>
              </defs>

              <!-- ==============================================
                   STAGE 1: SKETCH LAYER
                   ============================================== -->
              <g id="layer-sketch" class="hero-layer">
                <!-- Horizon line and Vanishing Rays -->
                <line x1="40" y1="620" x2="1560" y2="620" class="sketch-guide"/>
                <text x="60" y="612" class="sketch-annotation">H.L. (HORIZON ELEVATION +1.60)</text>

                <!-- Left Vanishing Rays (-400, 620) -->
                <line x1="280" y1="740" x2="720" y2="680" class="sketch-guide"/>
                <line x1="280" y1="540" x2="720" y2="480" class="sketch-guide"/>
                <line x1="360" y1="290" x2="720" y2="250" class="sketch-guide"/>

                <!-- Right Vanishing Rays (2200, 620) -->
                <line x1="720" y1="680" x2="1220" y2="660" class="sketch-guide"/>
                <line x1="720" y1="480" x2="1220" y2="460" class="sketch-guide"/>
                <line x1="720" y1="250" x2="1160" y2="260" class="sketch-guide"/>

                <!-- Ground Infinity Pool Perimeter Sketch -->
                <polygon points="200,910 780,850 740,690 260,730" class="sketch-line sketch-stroke" stroke-width="1.6"/>
                <!-- Pool stepping stones -->
                <polygon points="290,780 370,765 350,750 270,765" class="sketch-line sketch-stroke" stroke-width="1.2"/>
                <polygon points="390,760 470,745 450,730 370,745" class="sketch-line sketch-stroke" stroke-width="1.2"/>
                <polygon points="490,740 570,725 550,710 470,725" class="sketch-line sketch-stroke" stroke-width="1.2"/>

                <!-- Ground Level Living Pavilion -->
                <line x1="720" y1="680" x2="720" y2="480" class="sketch-line sketch-stroke" stroke-width="2.2"/>
                <line x1="1220" y1="660" x2="1220" y2="460" class="sketch-line sketch-stroke" stroke-width="2.2"/>
                <line x1="720" y1="680" x2="1220" y2="660" class="sketch-line sketch-stroke" stroke-width="2.2"/>
                <line x1="720" y1="480" x2="1220" y2="460" class="sketch-line sketch-stroke" stroke-width="2.2"/>

                <!-- Ground Floor Slender Steel Columns -->
                <line x1="860" y1="675" x2="860" y2="475" class="sketch-line sketch-stroke" stroke-width="1.5"/>
                <line x1="980" y1="670" x2="980" y2="470" class="sketch-line sketch-stroke" stroke-width="1.5"/>
                <line x1="1100" y1="665" x2="1100" y2="465" class="sketch-line sketch-stroke" stroke-width="1.5"/>

                <!-- Cantilever Floating Upper Volume -->
                <!-- Bottom soffit slab -->
                <polygon points="360,520 720,480 1160,470 780,510" class="sketch-line sketch-stroke" stroke-width="2.4"/>
                <!-- Front vertical corner -->
                <line x1="720" y1="480" x2="720" y2="250" class="sketch-line sketch-stroke" stroke-width="2.4"/>
                <!-- Left cantilever floating edge -->
                <line x1="360" y1="520" x2="360" y2="290" class="sketch-line sketch-stroke" stroke-width="2.4"/>
                <!-- Right volume edge -->
                <line x1="1160" y1="470" x2="1160" y2="260" class="sketch-line sketch-stroke" stroke-width="2.2"/>
                <!-- Top roof slab perimeter -->
                <polygon points="320,280 720,240 1200,250 780,200" class="sketch-line sketch-stroke" stroke-width="2.4"/>
                <!-- Upper floor glazing mullions -->
                <line x1="480" y1="506" x2="480" y2="277" class="sketch-line sketch-stroke" stroke-width="1.2"/>
                <line x1="600" y1="493" x2="600" y2="263" class="sketch-line sketch-stroke" stroke-width="1.2"/>

                <!-- Architectural Sketch Annotations -->
                <g class="sketch-annotations">
                  <path d="M 280 430 L 350 490" stroke="var(--color-accent)" stroke-width="1" marker-end="url(#arrow)"/>
                  <text x="160" y="420" class="sketch-annotation">4.2M FLOATING CANTILEVER</text>

                  <path d="M 980 380 L 1040 460" stroke="var(--color-accent)" stroke-width="1"/>
                  <text x="1000" y="370" class="sketch-annotation">FLOOR-TO-CEILING GLAZING</text>

                  <path d="M 520 860 L 560 810" stroke="var(--color-accent)" stroke-width="1"/>
                  <text x="420" y="880" class="sketch-annotation">REFLECTING WATER BASIN</text>
                </g>

                <!-- Pine tree gesture sketch on left -->
                <path d="M 170 750 Q 160 580 180 420" stroke="var(--color-ink)" stroke-width="2" fill="none"/>
                <path d="M 180 420 Q 120 400 90 440" stroke="var(--color-ink)" stroke-width="1.2" fill="none"/>
                <path d="M 180 460 Q 240 430 270 470" stroke="var(--color-ink)" stroke-width="1.2" fill="none"/>
                <path d="M 175 510 Q 100 480 80 520" stroke="var(--color-ink)" stroke-width="1.2" fill="none"/>
              </g>

              <!-- ==============================================
                   STAGE 2: BLUEPRINT LAYER
                   ============================================== -->
              <g id="layer-blueprint" class="hero-layer" opacity="0">
                <!-- Blueprint Grid Canvas -->
                <rect x="0" y="0" width="1600" height="1000" fill="url(#blueprint-grid-major)"/>

                <!-- Structural Grid Axis Lines -->
                <line x1="360" y1="120" x2="360" y2="860" class="blueprint-axis"/>
                <line x1="720" y1="120" x2="720" y2="860" class="blueprint-axis"/>
                <line x1="1160" y1="120" x2="1160" y2="860" class="blueprint-axis"/>

                <!-- Axis Bubbles Top -->
                <circle cx="360" cy="110" r="16" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <text x="360" y="115" text-anchor="middle" class="blueprint-text">A</text>

                <circle cx="720" cy="110" r="16" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <text x="720" y="115" text-anchor="middle" class="blueprint-text">B</text>

                <circle cx="1160" cy="110" r="16" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <text x="1160" y="115" text-anchor="middle" class="blueprint-text">C</text>

                <!-- Elevation Markers Left -->
                <text x="70" y="255" class="blueprint-dim">▲ ROOF SLAB +7.400</text>
                <line x1="180" y1="250" x2="320" y2="250" stroke="#4A90D9" stroke-width="1" stroke-dasharray="2,3"/>

                <text x="70" y="485" class="blueprint-dim">▲ FFL LEVEL 2 +3.600</text>
                <line x1="180" y1="480" x2="280" y2="480" stroke="#4A90D9" stroke-width="1" stroke-dasharray="2,3"/>

                <text x="70" y="685" class="blueprint-dim">▼ FFL LEVEL 1 +0.000</text>
                <line x1="180" y1="680" x2="260" y2="680" stroke="#4A90D9" stroke-width="1" stroke-dasharray="2,3"/>

                <!-- Dimension Strings (Dimension Ticks) -->
                <!-- Dim A-B (4,200mm) -->
                <line x1="360" y1="160" x2="720" y2="160" stroke="#4A90D9" stroke-width="1.2"/>
                <line x1="360" y1="152" x2="360" y2="168" stroke="#4A90D9" stroke-width="1.5"/>
                <line x1="720" y1="152" x2="720" y2="168" stroke="#4A90D9" stroke-width="1.5"/>
                <text x="540" y="152" text-anchor="middle" class="blueprint-dim">4,200 mm</text>

                <!-- Dim B-C (8,600mm) -->
                <line x1="720" y1="160" x2="1160" y2="160" stroke="#4A90D9" stroke-width="1.2"/>
                <line x1="1160" y1="152" x2="1160" y2="168" stroke="#4A90D9" stroke-width="1.5"/>
                <text x="940" y="152" text-anchor="middle" class="blueprint-dim">8,600 mm</text>

                <!-- Precise CAD Geometry of Pavilion -->
                <!-- Pool basin CAD -->
                <polygon points="200,910 780,850 740,690 260,730" class="blueprint-line" stroke-width="1.5"/>
                <!-- Pool water depth grid -->
                <line x1="230" y1="820" x2="760" y2="770" stroke="rgba(74, 144, 217, 0.4)" stroke-dasharray="3,3"/>

                <!-- Ground Floor Pavilion CAD with double walls -->
                <polygon points="720,680 1220,660 1220,460 720,480" class="blueprint-line" stroke-width="2"/>
                <!-- Inner offset wall line -->
                <polygon points="730,670 1210,652 1210,470 730,488" stroke="rgba(74, 144, 217, 0.5)" stroke-width="1" fill="none"/>

                <!-- Columns Crosshairs -->
                <circle cx="860" cy="575" r="7" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <line x1="850" y1="575" x2="870" y2="575" stroke="#4A90D9" stroke-width="1"/>
                <line x1="860" y1="565" x2="860" y2="585" stroke="#4A90D9" stroke-width="1"/>

                <circle cx="980" cy="570" r="7" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <line x1="970" y1="570" x2="990" y2="570" stroke="#4A90D9" stroke-width="1"/>
                <line x1="980" y1="560" x2="980" y2="580" stroke="#4A90D9" stroke-width="1"/>

                <circle cx="1100" cy="565" r="7" stroke="#4A90D9" stroke-width="1.5" fill="#0A1628"/>
                <line x1="1090" y1="565" x2="1110" y2="565" stroke="#4A90D9" stroke-width="1"/>
                <line x1="1100" y1="555" x2="1100" y2="575" stroke="#4A90D9" stroke-width="1"/>

                <!-- Cantilever Structure CAD -->
                <polygon points="360,520 720,480 1160,470 780,510" class="blueprint-line" stroke-width="2.2"/>
                <polygon points="360,290 720,250 1160,260 780,300" class="blueprint-line" stroke-width="2.2"/>
                <line x1="360" y1="520" x2="360" y2="290" class="blueprint-line" stroke-width="2.2"/>
                <line x1="720" y1="480" x2="720" y2="250" class="blueprint-line" stroke-width="2.2"/>
